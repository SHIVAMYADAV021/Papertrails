
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/submissions",
      "destination": "/api/submissions-handler?mode=visitor"
    },
    {
      "source": "/api/admin/submissions",
      "destination": "/api/submissions-handler?mode=admin"
    },
    {
      "source": "/api/admin-check",
      "destination": "/api/config-check"
    },
    {
      "source": "/api/env-check",
      "destination": "/api/config-check"
    }
  ]
}
